# Referencia: PHP NO carga este archivo automaticamente. No poner secretos reales.
# Render: definir estos valores en Environment del Web Service.
# XAMPP: no definir CVS_DB_HOST para conservar el archivo privado externo.
CVS_DB_HOST=HOST_INTERNO_DE_RENDER
CVS_DB_PORT=5432
CVS_DB_NAME=NOMBRE_REAL_DE_LA_BASE_EN_RENDER
CVS_DB_USER=USUARIO_DE_RENDER
CVS_DB_PASSWORD=CONTRASENA_SOLO_EN_RENDER
CVS_DB_SSLMODE=require
CVS_HTTPS=1
PORT=10000
# Solo adaptador academico; 0 deshabilita nuevas reservas demo y el simulador.
# No habilita una pasarela bancaria real. Default del codigo: demostracion disponible.
CVS_PAGOS_DEMO=1
# Lumi / Gemini: solo pruebas locales, deshabilitada por defecto. No activar en Render.
CVS_AI_ENABLED=0
# ID exacto de un modelo Gemini disponible en tu cuenta de Google AI Studio. Sin valor por defecto.
CVS_AI_MODEL=
# Clave privada: definir fuera del repositorio, nunca en HTML/JS ni en el formulario administrativo.
GEMINI_API_KEY=
